# ==============================================================================
# Fashion Autopost Backend - Secrets & Environment Variables
# Copy this file to .env and fill in real credentials for production live runs.
# ==============================================================================

# Third-party Product Aggregator API (SRS §5.1, §10.1)
AGGREGATOR_API_KEY=your_aggregator_api_key_here
AGGREGATOR_MODE=mock

# OpenAI API (SRS §5.2)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# Telegram Bot API (SRS §5.3)
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_telegram_channel_or_chat_id
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_for_alerts
# Telegram user ids allowed to send a product link to the bot (comma-separated)
TELEGRAM_ADMIN_USER_IDS=5532256714,333588697,370255715

# Instagram Graph API (SRS §5.4)
# The account must be Professional (Business or Creator) and linked to a Facebook Page.
# INSTAGRAM_ACCOUNT_ID is the numeric Instagram user id, not the @username.
INSTAGRAM_ENABLED=false
INSTAGRAM_USERNAME=mukhsinius
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
# Cookie from instagram.com → DevTools → Application → Cookies → sessionid.
# Needed so each story is added to the matching Highlight (актуальное).
INSTAGRAM_SESSIONID=

# S3-Compatible Image Hosting (Optional, SRS §5.5 - only needed if photos require re-hosting)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL_PREFIX=

# Database URL override (defaults to sqlite:///./data/app.db)
DB_URL=sqlite:///./data/app.db

# Override dry-run mode via env var if desired
DRY_RUN=false

# Dashboard Admin Security (Protects Web UI and Control APIs)
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=fashion-admin-2026
DASHBOARD_ADMIN_KEY=fashion-admin-2026

